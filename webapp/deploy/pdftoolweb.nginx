# PDF Tool web — nginx reverse proxy
#
# The Go binary listens on 127.0.0.1:8080. nginx terminates TLS, serves the
# app, and raises the upload limit (PDFs can be large).
#
# Install (Debian/Ubuntu):
#   sudo cp deploy/pdftoolweb.nginx /etc/nginx/sites-available/pdftoolweb
#   sudo ln -s /etc/nginx/sites-available/pdftoolweb /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # Large PDF uploads (match the app's 150 MB MaxUpload).
    client_max_body_size 160m;

    # Long-running ops (compress/merge on big files).
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Gzip the SPA + JSON (rendered page PNGs are already compressed).
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

